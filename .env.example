# Variáveis da Vercel (Settings → Environment Variables)

# Seu usuário e senha de primeiro acesso (desenvolvedor). No primeiro login o painel pede para trocar a senha;
# depois disso a senha daqui não vale mais.
# DEV_USUARIO=  (opcional, padrão: eduardo)
DEV_SENHA_INICIAL=

# Preenchidas sozinhas quando você conecta o Upstash Redis em Storage na Vercel:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Sem elas (no computador, com npm run dev) os dados ficam no arquivo .dados-dev.json
